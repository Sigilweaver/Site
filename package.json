{
    "name": "sigilweaver-site",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "typecheck": "tsc",
        "build": "tsc && vite build && node scripts/generate-sitemaps.mjs && node scripts/generate-llms.mjs && node scripts/check-links.mjs",
        "check-links": "node scripts/check-links.mjs",
        "og": "node scripts/render-og.mjs",
        "preview": "vite preview",
        "test": "vitest run",
        "deploy": "bun run build && bunx wrangler deploy"
    },
    "dependencies": {
        "lucide": "^1.68.0"
    },
    "devDependencies": {
        "@types/node": "^22.20.5",
        "autoprefixer": "^10.6.2",
        "postcss": "^8.5.32",
        "tailwindcss": "^3.4.14",
        "typescript": "^5.6.3",
        "vite": "^8.3.6",
        "vitest": "^4.1.12"
    }
}
